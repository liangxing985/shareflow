# ===== 数据库配置 =====
MYSQL_ROOT_PASSWORD=your_strong_mysql_root_password
MYSQL_DATABASE=shareflow
MYSQL_USER=shareflow
MYSQL_PASSWORD=your_strong_mysql_password
MYSQL_PORT=3306

# ===== Redis配置 =====
REDIS_PORT=6379

# ===== 应用环境配置 =====
# production: 生产环境（关闭API文档，强制校验密钥）
# development: 开发环境（开启API文档）
ENV=production
DEBUG=false

# ===== 应用安全配置（生产环境必须修改！）=====
# SECRET_KEY: JWT签名密钥，至少32位随机字符串
# 生成方式: openssl rand -hex 32
SECRET_KEY=please-change-this-to-a-random-string-at-least-32-chars-long
# ENCRYPTION_KEY: 敏感数据加密密钥，至少32位随机字符串
# 生成方式: openssl rand -hex 32
ENCRYPTION_KEY=please-change-this-to-a-random-encryption-key-32

# ===== CORS配置（生产环境建议配置具体域名）=====
# 多个域名用逗号分隔，如: https://your-domain.com,https://admin.your-domain.com
# 开发环境可用 *
CORS_ORIGINS=*

# ===== API接入鉴权（业务系统对接用）=====
# 配置后，调用 /api/v1/orders/api/create 必须在请求头携带 X-API-Key
# 多个Key用逗号分隔
# 生成方式: openssl rand -hex 32
API_KEYS=

# ===== 文件上传配置 =====
UPLOAD_DIR=uploads
# 最大上传大小（字节），默认10MB
MAX_UPLOAD_SIZE=10485760

# ===== 登录安全配置 =====
# 登录最大失败次数，超过后锁定
LOGIN_MAX_ATTEMPTS=5
# 锁定时间（分钟）
LOGIN_LOCK_MINUTES=15

# ===== 端口配置 =====
BACKEND_PORT=8000
FRONTEND_PORT=8080

# ===== 平台抽成默认配置 =====
DEFAULT_PLATFORM_FEE_RATE=0.10
